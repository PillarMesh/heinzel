# Keep the Docker build context to the sources the image builds from. Local
# environments are both the bulk of the context and a correctness hazard: a copied
# host `node_modules` overwrites the one the image installed.
.venv
**/node_modules
.git
.mypy_cache
.pytest_cache
.ruff_cache
.hypothesis
**/dist
**/test-results
# The suites are the rest of the bulk, and nothing the image runs reaches them: the console
# server is installed from its own package, and the browser journeys under
# `apps/console/e2e*` are driven from a checkout, never from this image.
**/tests
apps/console/e2e*
