# Exact M0 acceptance variable inventory. Copy names into an external secret
# manager or an ephemeral shell environment; never put real values in this file.

# Private local state/output (absolute and owner-only, outside this repository).
PILLARMESH_STATE_PATH=/absolute/private/operator-unique/state.db
PILLARMESH_OUTPUT_DIR=/absolute/private/operator-unique/output
PILLARMESH_CLEANUP_LEDGER_PATH=/absolute/private/operator-unique/cleanup-ledger.json

# Signing (a distinct key identifier and key for each operator).
PILLARMESH_SIGNING_KEY_ID=operator-unique-key-id
PILLARMESH_SIGNING_PRIVATE_KEY_B64=<secret-from-external-secret-manager>

# Runtime PostgreSQL (read-only).
PILLARMESH_POSTGRES_DSN=<secret-from-external-secret-manager>
PILLARMESH_POSTGRES_DATABASE=M0_ACCEPTANCE_DATABASE
PILLARMESH_POSTGRES_RUNTIME_PRINCIPAL=pillarmesh_m0_runtime_operator_unique
PILLARMESH_POSTGRES_OWNER_PRINCIPAL=pillarmesh_m0_owner
PILLARMESH_POSTGRES_CONNECTION_HANDLE=pg-operator-opaque
PILLARMESH_POSTGRES_SCHEMA=pillarmesh_m0
PILLARMESH_POSTGRES_TABLE=orders
PILLARMESH_POSTGRES_DENIAL_SCHEMA=unrelated_private

# Fixture-only PostgreSQL (INSERT/DELETE only; never supplied to product CLI).
PILLARMESH_POSTGRES_FIXTURE_DSN=<secret-from-external-secret-manager>
PILLARMESH_POSTGRES_FIXTURE_PRINCIPAL=pillarmesh_m0_fixture

# Runtime Snowflake.
PILLARMESH_SNOWFLAKE_ACCOUNT=<secret-account-identifier>
PILLARMESH_SNOWFLAKE_USER=PILLARMESH_M0_RUNTIME_OPERATOR_UNIQUE
PILLARMESH_SNOWFLAKE_PASSWORD=<secret-from-external-secret-manager>
PILLARMESH_SNOWFLAKE_OWNER_USER=PILLARMESH_M0_OWNER
PILLARMESH_SNOWFLAKE_ROLE=PILLARMESH_M0_RUNTIME
PILLARMESH_SNOWFLAKE_WAREHOUSE=PILLARMESH_M0_WH
PILLARMESH_SNOWFLAKE_DATABASE=PILLARMESH_M0
PILLARMESH_SNOWFLAKE_SCHEMA=TRANSFER
PILLARMESH_SNOWFLAKE_STAGE=M0_STAGE
PILLARMESH_SNOWFLAKE_TARGET_TABLE=ORDERS
PILLARMESH_SNOWFLAKE_NEGATIVE_TARGET_TABLE=ORDERS_UNSUPPORTED_KEY
PILLARMESH_SNOWFLAKE_LEDGER_TABLE=COMMIT_LEDGER
PILLARMESH_SNOWFLAKE_CONNECTION_HANDLE=sf-operator-opaque
PILLARMESH_SNOWFLAKE_DENIAL_DATABASE=UNRELATED_PRIVATE

# Evidence scan canaries. The JSON array values and row value are private.
PILLARMESH_CREDENTIAL_CANARIES_JSON=<secret-json-array-from-external-secret-manager>
PILLARMESH_ROW_VALUE_CANARY=<secret-synthetic-row-value>

# Acceptance operator metadata. Values are non-secret and contain no account IDs.
PILLARMESH_OPERATOR_PSEUDONYM=operator-opaque
PILLARMESH_HOST_PSEUDONYM=host-opaque
PILLARMESH_MCP_PROTOCOL_VERSION=2025-06-18
PILLARMESH_OWNER_AUTHORIZATION_REFERENCE=owner-approval-opaque-reference
