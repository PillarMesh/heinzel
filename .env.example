# Variables for the PostgreSQL-to-Snowflake snapshot acceptance run,
# tests/acceptance/run_snapshot.py, which exercises a real PostgreSQL source and a real
# Snowflake account end to end. The harness reads them from the process environment, not
# from this file. The offline suite and the Docker-backed live tests do not need them.
#
# This is the exact inventory the harness requires (tests/acceptance/config.py). Copy the
# names into an external secret manager or an ephemeral shell environment; never put real
# values in this file.

# Private local state/output (absolute and owner-only, outside this repository).
HEINZEL_STATE_PATH=/absolute/private/operator-unique/state.db
HEINZEL_OUTPUT_DIR=/absolute/private/operator-unique/output
HEINZEL_CLEANUP_LEDGER_PATH=/absolute/private/operator-unique/cleanup-ledger.json

# Signing (a distinct key identifier and key for each operator).
HEINZEL_SIGNING_KEY_ID=operator-unique-key-id
HEINZEL_SIGNING_PRIVATE_KEY_B64=<secret-from-external-secret-manager>

# Runtime PostgreSQL (read-only).
HEINZEL_POSTGRES_DSN=<secret-from-external-secret-manager>
HEINZEL_POSTGRES_DATABASE=SNAPSHOT_ACCEPTANCE_DATABASE
HEINZEL_POSTGRES_RUNTIME_PRINCIPAL=heinzel_snapshot_runtime_operator_unique
HEINZEL_POSTGRES_OWNER_PRINCIPAL=heinzel_snapshot_owner
HEINZEL_POSTGRES_CONNECTION_HANDLE=pg-operator-opaque
HEINZEL_POSTGRES_SCHEMA=heinzel_snapshot
HEINZEL_POSTGRES_TABLE=orders
HEINZEL_POSTGRES_DENIAL_SCHEMA=unrelated_private

# Fixture-only PostgreSQL (INSERT/DELETE only; never supplied to product CLI).
HEINZEL_POSTGRES_FIXTURE_DSN=<secret-from-external-secret-manager>
HEINZEL_POSTGRES_FIXTURE_PRINCIPAL=heinzel_snapshot_fixture

# Runtime Snowflake.
HEINZEL_SNOWFLAKE_ACCOUNT=<secret-account-identifier>
HEINZEL_SNOWFLAKE_USER=HEINZEL_SNAPSHOT_RUNTIME_OPERATOR_UNIQUE
HEINZEL_SNOWFLAKE_PASSWORD=<secret-from-external-secret-manager>
HEINZEL_SNOWFLAKE_OWNER_USER=HEINZEL_SNAPSHOT_OWNER
HEINZEL_SNOWFLAKE_ROLE=HEINZEL_SNAPSHOT_RUNTIME
HEINZEL_SNOWFLAKE_WAREHOUSE=HEINZEL_SNAPSHOT_WH
HEINZEL_SNOWFLAKE_DATABASE=HEINZEL_SNAPSHOT
HEINZEL_SNOWFLAKE_SCHEMA=TRANSFER
HEINZEL_SNOWFLAKE_STAGE=SNAPSHOT_STAGE
HEINZEL_SNOWFLAKE_TARGET_TABLE=ORDERS
HEINZEL_SNOWFLAKE_NEGATIVE_TARGET_TABLE=ORDERS_UNSUPPORTED_KEY
HEINZEL_SNOWFLAKE_LEDGER_TABLE=COMMIT_LEDGER
HEINZEL_SNOWFLAKE_CONNECTION_HANDLE=sf-operator-opaque
HEINZEL_SNOWFLAKE_DENIAL_DATABASE=UNRELATED_PRIVATE

# Evidence scan canaries. The JSON array values and row value are private.
HEINZEL_CREDENTIAL_CANARIES_JSON=<secret-json-array-from-external-secret-manager>
HEINZEL_ROW_VALUE_CANARY=<secret-synthetic-row-value>

# Acceptance operator metadata. Values are non-secret and contain no account IDs.
HEINZEL_OPERATOR_PSEUDONYM=operator-opaque
HEINZEL_HOST_PSEUDONYM=host-opaque
HEINZEL_MCP_PROTOCOL_VERSION=2025-06-18
HEINZEL_OWNER_AUTHORIZATION_REFERENCE=owner-approval-opaque-reference
